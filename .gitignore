# ---- Unity (patterns match the Unity project wherever it sits in the repo) ----
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# Never ignore Asset meta data
!/**/[Aa]ssets/**/*.meta

# IDE / generated project files
.vs/
.vscode/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.apk
*.aab
*.unitypackage
crashlytics-build.properties

# ---- Python / Jupyter ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Run outputs (regenerate by running the notebook; remove these lines to commit them)
python/unity_run_log.csv

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
